# ------------------------------------------------------------------
# Meredian backend (NestJS) — variables d'environnement
# Copier ce fichier en `.env` puis renseigner les vraies valeurs.
# Le `.env` ne doit JAMAIS être committé (voir .gitignore).
# ------------------------------------------------------------------

# --- Serveur ---
NODE_ENV=development
PORT=4000
# Préfixe global de l'API (les routes deviennent /api/auth/login, etc.)
API_PREFIX=api
# Origines autorisées pour CORS (séparées par des virgules, ou * en dev)
CORS_ORIGIN=http://localhost:5173

# --- Base de données PostgreSQL ---
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://meredian:meredian@localhost:5432/meredian?schema=public

# --- Authentification JWT ---
# Générer une valeur longue et aléatoire, ex : `openssl rand -hex 48`
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d

# --- Paiements (Naboopay) ---
# Intégration réelle repoussée. En développement, MOCK_PAYMENTS=true confirme
# immédiatement les paiements sans appeler l'API Naboopay.
MOCK_PAYMENTS=true
NABOOPAY_API_URL=https://api.naboopay.com
NABOOPAY_API_KEY=
# Secret partagé pour vérifier la signature HMAC-SHA256 des webhooks.
# Valeur générique à ajuster une fois la documentation officielle Naboopay obtenue.
NABOOPAY_WEBHOOK_SECRET=change-me-webhook-secret
# Nom du header HTTP portant la signature du webhook (à confirmer avec la doc Naboopay).
NABOOPAY_WEBHOOK_SIGNATURE_HEADER=x-naboopay-signature

# --- Compte admin créé par le seed ---
SEED_ADMIN_EMAIL=admin@meredian.io
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Admin Meredian
